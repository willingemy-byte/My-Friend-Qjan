# Configuration du backend TreeAI, jamais de l'APK. Valeurs d'exemple seulement.
# Le processus charge ces variables via son environnement (.env chargé par l'hébergeur).
TREEAI_BASE_URL=https://ollama.com/v1
TREEAI_MODEL=gemma4:31b
TREEAI_KEY_ENV=OLLAMA_API_KEY
OLLAMA_API_KEY=

# Pour Model Studio : utiliser l'adresse exacte de la région/espace Alibaba.
# TREEAI_BASE_URL=<adresse HTTPS compatible OpenAI terminée par /v1>
# TREEAI_MODEL=<identifiant exact du modèle Alibaba>
# TREEAI_KEY_ENV=ALIBABA_API_KEY
# ALIBABA_API_KEY=

# Pour votre serveur ECS avec une API compatible OpenAI :
# TREEAI_BASE_URL=https://<domaine-du-serveur>/v1
# TREEAI_MODEL=<modèle réellement installé sur ECS>
# TREEAI_KEY_ENV=ECS_API_KEY
# ECS_API_KEY=
